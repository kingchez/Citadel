# Supabase - service role key, server-side only (never exposed to the browser)
SUPABASE_URL=https://kmilcowgyeboyzozdrpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the n8n instance - both Video Pipeline and Video Pipeline —
# Retries webhooks live under this same host
N8N_BASE_URL=https://n8n.viralnotely.com

# Citadel auth - single shared password, no email/username.
# CITADEL_SESSION_SECRET should be a long random string (e.g. `openssl rand -hex 32`);
# changing it invalidates all existing sessions.
CITADEL_PASSWORD=
CITADEL_SESSION_SECRET=

# Product finder (paste a script -> find each product's Amazon link on the channel's product sites).
# Goes through OmniRoute's OpenAI-compatible /v1 side. The model can be any model or combo name OmniRoute exposes.
OMNIROUTE_BASE_URL=https://omniroute.viralnotely.com/v1
OMNIROUTE_API_KEY=
PRODUCT_AI_MODEL=
